# Port ml-service runs on
ML_SERVICE_PORT=8003

# Must be the EXACT same value used by prompt-service, review-service, and
# analytics-service - this is what lets a Python service verify a JWT a
# Java service issued.
JWT_SECRET=replace-with-the-same-shared-secret-used-in-week-2

# Base URLs for the two Java services this service calls over HTTP
PROMPT_SERVICE_URL=http://localhost:8000
REVIEW_SERVICE_URL=http://localhost:8001

# Dedicated "machine" credentials ml-service logs in with to call the other
# two services. NOTE: as a known simplification for this exercise (same one
# analytics-service used in Week 3), this currently reuses the same single
# account mechanism prompt-service's /auth/login was built for - see README.
ML_SERVICE_USERNAME=replace-with-real-username
ML_SERVICE_PASSWORD=replace-with-real-password

# Free Hugging Face access token - create one at
# https://huggingface.co/settings/tokens (Read scope is enough). Never a
# real token in this file or in git.
HUGGINGFACE_API_TOKEN=replace-with-your-hf-token

# Model IDs used for the two ML features. Confirm both are still available
# on the free serverless tier before relying on them - see README.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# How often (in seconds) the background job re-checks for new/changed
# prompts and reviews and calls Hugging Face only for what changed
ML_REFRESH_INTERVAL_SEC=120

# Minimum model confidence (0-1) required before a sentiment/score
# disagreement is flagged in the review quality check
SENTIMENT_CONFIDENCE_THRESHOLD=0.75
