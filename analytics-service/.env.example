# Port analytics-service listens on
ANALYTICS_SERVICE_PORT=8002

# Must be the EXACT same value used by prompt-service and review-service -
# this is what lets a Python service verify a JWT a Java service issued.
JWT_SECRET=replace-with-the-same-shared-secret-used-in-week-2

# Base URLs for the two Java services this service calls over HTTP
PROMPT_SERVICE_URL=http://localhost:8000
REVIEW_SERVICE_URL=http://localhost:8001

# Dedicated "machine" credentials analytics-service logs in with to call the
# other two services. NOTE: as a known simplification for this exercise, this
# currently reuses the same single account prompt-service's /auth/login was
# built for in Week 2 - see README for why that's not ideal in a real system.
ANALYTICS_SERVICE_USERNAME=replace-with-real-username
ANALYTICS_SERVICE_PASSWORD=replace-with-real-password

# How often (in seconds) the background job re-fetches data and recomputes
# the analytics snapshot
ANALYTICS_REFRESH_INTERVAL_SEC=60